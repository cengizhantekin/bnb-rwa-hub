[Unit]
Description=BNB RWA Hub daily bStocks technical watchlist refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/bhub.tm.biz.tr/private/agent
ExecStart=/usr/bin/python3 /home/bhub.tm.biz.tr/private/agent/rwa-technical-scan.py --sync-all-bstocks
ExecStartPost=/usr/bin/php /home/bhub.tm.biz.tr/private/agent/sync-technical-db.php
Environment=PYTHONUNBUFFERED=1
UMask=0077
Nice=10
TimeoutStartSec=25min
